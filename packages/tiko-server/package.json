{
  "name": "@tiko/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:push": "drizzle-kit push && DATABASE_NAME=tiko_test drizzle-kit push --force",
    "db:reset": "node scripts/db-reset.ts && drizzle-kit push",
    "dev": "node --watch src/index.ts",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@tiko/domain": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "catalog:",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
