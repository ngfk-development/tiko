{
  "compilerOptions": {
    "target": "es2023",
    /* No DOM and no Node types: this package must run in both. */
    "lib": ["ES2023"],
    "types": [],
    "module": "nodenext",
    "skipLibCheck": true,

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
  },
  "include": ["src"],
}
